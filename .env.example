# Copy to .env on the VPS and fill in. NEVER commit .env.

# Public hostname Caddy serves (point an A record at the VPS IP first).
RENDER_DOMAIN=render.yourdomain.com

# Shared secret. Generate with: openssl rand -hex 32
# The SAME value goes in each SaaS app's hosting env as RENDER_SERVER_TOKEN.
RENDER_SERVER_TOKEN=

# R2 — the bucket rendered MP4s are uploaded to.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of that bucket (used for the /jobs/:id/output redirect).
R2_PUBLIC_URL=

# ── Tuning (defaults are sized for 8 vCPU / 16 GB) ───────────────────────────
# Browser tabs rendering frames in parallel. 8 = all cores.
RENDER_MEDIA_CONCURRENCY=8
# Renders at once; 1 = each render gets the full machine, others queue.
MAX_PARALLEL_JOBS=1
# Uncomment if `--log=verbose` shows encoding (not frame capture) is the
# bottleneck: ~2x faster x264 encode for slightly larger files.
# RENDER_X264_PRESET=faster
