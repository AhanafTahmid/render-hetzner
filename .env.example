# Copy to .env on the VPS and fill in. NEVER commit .env.

# Public hostname Caddy serves (point an A record at the VPS IP first).
RENDER_DOMAIN=render.yourdomain.com

# Shared secret. Generate with: openssl rand -hex 32
# The SAME value goes in each SaaS app's hosting env as RENDER_SERVER_TOKEN.
RENDER_SERVER_TOKEN=

# R2 — the bucket rendered MP4s are uploaded to.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of that bucket (used for the /jobs/:id/output redirect).
R2_PUBLIC_URL=

# ── Tuning (16 vCPU / 32 GB — Hetzner CX53) ──────────────────────────────────
# Browser tabs rendering frames in parallel. NOT the core count — benchmarked on
# a real vidshero job (1698 frames, 11 clips, 150 captions) on the 16-core box:
#   conc 4 = 110.9s | 6 = 93.5s | 8 = 78.7-83.8s | 12 = 81.6s | 16 = 84.7s
# 8-12 wins. Past 12 the capture tabs thrash against ffmpeg's encoder threads
# (run queue 17-34 on 16 cores, ~100k context switches/sec); below 8 the box
# starves (33% idle at conc 4). Remotion hard-caps this at the core count.
RENDER_MEDIA_CONCURRENCY=8
# Renders at once; 1 = each render gets the full machine, others queue.
MAX_PARALLEL_JOBS=1
# Encoder preset. Measured on the same job at conc 16: medium 93.2s/87.8s (two
# runs — note the ~6% run-to-run noise), faster 86.9s, veryfast 84.7s. Frame
# capture dominates (chrome ~643% CPU vs ffmpeg ~322%), so this is worth only a
# few percent — but it is free, so take it.
RENDER_X264_PRESET=veryfast
